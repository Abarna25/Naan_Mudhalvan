datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  name             String
  role             String         @default("STUDENT") // STUDENT | FACULTY | PLACEMENT_OFFICER | ADMIN
  department       String?
  naanMudhalvanId  String?        @unique
  emailVerified    Boolean        @default(false)
  avatarUrl        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  profile               Profile?
  academicIdentity      AcademicIdentity?
  notifications         Notification[]
  auditLogs             AuditLog[]
  facultyVerifications  FacultyVerification[] @relation("FacultyVerifications")
}

model AcademicIdentity {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId           String   @unique
  rollNumber          String   @unique
  institutionalEmail String   @unique
  name                String
  collegeName         String   @default("Government Engineering College, Salem")
  department          String   @default("Computer Science & Engineering")
  program             String   @default("B.E. Computer Science and Engineering")
  year                Int      @default(3)
  semester            Int      @default(6)
  batch               String   @default("2022-2026")
  section             String   @default("A")
  academicStatus      String   @default("ACTIVE") // ACTIVE | GRADUATED | SUSPENDED
  cgpa                Float    @default(8.5)
  verificationStatus  String   @default("VERIFIED") // VERIFIED | PENDING | REJECTED
  verifiedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VerificationToken {
  id          String   @id @default(uuid())
  email       String
  rollNumber  String
  token       String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Profile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  cgpa               Float            @default(0.0)
  graduationYear     Int              @default(2025)
  phone              String?
  collegeName        String           @default("Government Engineering College, Salem")
  githubUsername     String?
  leetcodeUsername   String?
  hackerrankUsername String?
  linkedinUrl        String?
  portfolioSlug      String?          @unique
  isPublic           Boolean          @default(true)
  profileCompletion  Int              @default(30)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  skills             StudentSkill[]
  projects           Project[]
  certifications     Certification[]
  achievements       Achievement[]
  internships        Internship[]
  codingProfile      CodingProfile?
  employmentScores   EmploymentScore[]
  skillGaps          SkillGap[]
  roadmaps           Roadmap[]
  portfolioVersions  PortfolioVersion[]
  resumeVersions     ResumeVersion[]
  recommendations    Recommendation[]
  placementClaims    PlacementClaim[]
  trustScore         TrustScore?
}

model Skill {
  id        String         @id @default(uuid())
  name      String         @unique
  category  String         @default("General")
  students  StudentSkill[]
}

model StudentSkill {
  id             String          @id @default(uuid())
  profileId      String
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency    Int             @default(70)
  verifiedSource String          @default("Self Verified")
  status         String          @default("SELF_DECLARED") // SELF_DECLARED | EVIDENCE_FOUND | PARTIALLY_VERIFIED | VERIFIED | HIGH_CONFIDENCE | MANUAL_REVIEW
  confidenceScore Int            @default(20) // 0-100
  assessmentScore Float?
  evidences      SkillEvidence[]

  @@unique([profileId, skillId])
}

model SkillEvidence {
  id             String       @id @default(uuid())
  studentSkillId String
  studentSkill   StudentSkill @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)
  evidenceType   String       // ASSESSMENT | FACULTY_APPROVAL | VERIFIED_CERTIFICATE | GITHUB_PROJECT | ACADEMIC_COURSE | SELF_DECLARED
  sourceId       String?
  description    String
  weight         Float        @default(1.0)
  confidenceDelta Int         @default(10)
  verifiedAt     DateTime     @default(now())
}

model SkillAssessment {
  id             String                    @id @default(uuid())
  skillName      String
  category       String                    @default("Technical")
  title          String
  description    String
  totalQuestions Int                       @default(5)
  passingScore   Int                       @default(60) // Percentage
  createdAt      DateTime                  @default(now())
  questions      SkillAssessmentQuestion[]
  attempts       SkillAssessmentAttempt[]
}

model SkillAssessmentQuestion {
  id                 String          @id @default(uuid())
  assessmentId       String
  assessment         SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionText       String
  optionsJson        String          // JSON string array of options
  correctAnswerIndex Int             // 0-indexed
  explanation        String?
}

model SkillAssessmentAttempt {
  id               String          @id @default(uuid())
  assessmentId     String
  assessment       SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId         String          // User ID
  score            Float           @default(0.0) // Percentage
  passed           Boolean         @default(false)
  status           String          @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | EXPIRED
  startedAt        DateTime        @default(now())
  submittedAt      DateTime?
  userAnswersJson  String?         // JSON array of answers submitted
}

model Project {
  id          String           @id @default(uuid())
  profileId   String
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String
  techStack   String   
  githubUrl   String?
  liveUrl     String?
  stars       Int              @default(0)
  status      String           @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPICIOUS | MANUAL_REVIEW_REQUIRED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  evidence    ProjectEvidence?
}

model ProjectEvidence {
  id                        String   @id @default(uuid())
  projectId                 String   @unique
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoOwner                 String?
  repoName                  String?
  repoAgeMonths             Int      @default(0)
  commitCount               Int      @default(0)
  commitFrequency           String?  // 'HIGH' | 'MEDIUM' | 'LOW'
  studentContributionFound Boolean  @default(false)
  contributionPercentage    Float    @default(0.0)
  languageBreakdown         String?  // JSON string
  contributorsCount         Int      @default(1)
  hasReadme                 Boolean  @default(false)
  recentActivityDays        Int      @default(0)
  evidenceScore             Int      @default(0) // 0-100
  contributionStatus        String   @default("MANUAL_REVIEW_REQUIRED") // OWNER_VERIFIED | CONTRIBUTOR_VERIFIED | NO_CONTRIBUTION_FOUND | REPOSITORY_NOT_FOUND | PRIVATE_REPOSITORY | MANUAL_REVIEW_REQUIRED
  riskFlags                 String?  // JSON array of suspicious indicators
  verifiedAt                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Certification {
  id           String                   @id @default(uuid())
  profileId    String
  profile      Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  issuer       String
  issueDate    String?
  credentialId String?
  fileUrl      String?
  ocrExtracted Boolean                  @default(false)
  isDuplicate  Boolean                  @default(false)
  status       String                   @default("PENDING") // PENDING | APPROVED | REJECTED | VERIFIED | MANUAL_REVIEW_REQUIRED | INVALID
  createdAt    DateTime                 @default(now())

  verification CertificateVerification?
}

model CertificateVerification {
  id                   String        @id @default(uuid())
  certificationId      String        @unique
  certification        Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  fileHash             String?
  verificationUrl      String?
  verificationDomain   String?
  verificationResponse String?       // JSON response from HTTP validation
  qrCodeData           String?
  issuerVerified       Boolean       @default(false)
  verificationStatus   String        @default("PENDING") // PENDING | VERIFIED | REJECTED | MANUAL_REVIEW | INVALID | CREDENTIAL_REUSE_SUSPECTED
  verificationMethod   String        @default("URL_AND_QR") // URL_AND_QR | ISSUER_API | FACULTY_MANUAL | NONE
  verifiedBy           String?       // Faculty User ID or 'SYSTEM'
  verifiedAt           DateTime?
  riskFlags            String?       // JSON array of risk flags
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Achievement {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("Hackathon")
  description String
  date        String
  issuer      String?
}

model Internship {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String
  endDate     String
  description String
}

model CodingProfile {
  id               String   @id @default(uuid())
  profileId        String   @unique
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  leetcodeSolved   Int      @default(0)
  leetcodeRating   Int      @default(0)
  hackerrankStars  Int      @default(0)
  githubRepos      Int      @default(0)
  githubStars      Int      @default(0)
  githubCommits    Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model EmploymentScore {
  id                     String   @id @default(uuid())
  profileId              String
  profile                Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  overallScore           Int      @default(75)
  technicalReadiness     Int      @default(75)
  projectStrength        Int      @default(80)
  codingReadiness        Int      @default(70)
  communicationReadiness Int      @default(72)
  placementProbability   Int      @default(78)
  explainabilityJson     String   
  createdAt              DateTime @default(now())
}

model SkillGap {
  id                       String   @id @default(uuid())
  profileId                String
  profile                  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetRole               String
  missingSkillsJson        String   
  recommendedResourcesJson String   
  projectIdeasJson         String   
  timelineMonths           Int      @default(3)
  createdAt                DateTime @default(now())
}

model Roadmap {
  id                    String   @id @default(uuid())
  profileId             String
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetRole            String
  weeklyPlanJson        String   
  monthlyGoalsJson      String   
  certificationPlanJson String  
  createdAt             DateTime @default(now())
}

model PortfolioVersion {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  theme       String   @default("modern")
  customCss   String?
  publishedAt DateTime @default(now())
  slug        String   @unique
}

model ResumeVersion {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetRole String   @default("Software Engineer")
  atsScore   Int      @default(85)
  resumeJson String   
  fileUrl    String?
  createdAt  DateTime @default(now())
}

model Recommendation {
  id           String   @id @default(uuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         String   
  title        String
  description  String
  actionUrl    String?
  impactPoints Int      @default(5)
  createdAt    DateTime @default(now())
}

model PlacementClaim {
  id                 String   @id @default(uuid())
  profileId          String
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  companyName        String
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])
  roleTitle          String
  packageLpa         Float?
  offerLetterUrl     String?
  joiningLetterUrl   String?
  claimStatus        String   @default("PENDING_VERIFICATION") // CLAIMED | PENDING_VERIFICATION | VERIFIED | REJECTED
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Company {
  id              String           @id @default(uuid())
  name            String           @unique
  normalizedName  String           @unique
  tier            String           @default("Tier 2") // Tier 1 | Tier 2 | Tier 3 | Startup
  isRegistered    Boolean          @default(true)
  placementClaims PlacementClaim[]
}

model FacultyVerification {
  id         String   @id @default(uuid())
  facultyId  String
  faculty    User     @relation("FacultyVerifications", fields: [facultyId], references: [id])
  studentId  String
  targetType String   // CERTIFICATE | PROJECT | SKILL | PLACEMENT | IDENTITY
  targetId   String
  action     String   // APPROVE | REJECT | REQUEST_MORE_EVIDENCE | FLAG_FOR_ADMIN
  reason     String?
  ipAddress  String
  createdAt  DateTime @default(now())
}

model TrustScore {
  id                     String   @id @default(uuid())
  profileId              String   @unique
  profile                Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  overallDataConfidence  Int      @default(50) // 0-100
  identityScore          Int      @default(0)
  academicScore          Int      @default(0)
  skillScore             Int      @default(0)
  projectScore           Int      @default(0)
  certificationScore     Int      @default(0)
  placementScore         Int      @default(0)
  riskLevel              String   @default("LOW") // LOW | MEDIUM | HIGH
  breakdownJson          String   // JSON string of detailed breakdown
  updatedAt              DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

